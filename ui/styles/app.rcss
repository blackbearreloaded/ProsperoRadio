:root {
    --bg: #071016;
    --surface: #0d1b24;
    --surface-raised: #142934;
    --surface-selected: #1c3b48;
    --border: #31505d;
    --text: #f2f7f8;
    --muted: #b7c7cb;
    --accent: #70e1dc;
    --success: #69d997;
    --danger: #ff7c7c;
}

* { box-sizing: border-box; }
div, header, main, section, nav, aside, footer, h1, h2, p { display: block; }

body {
    margin: 0;
    width: 100%;
    height: 100%;
    min-width: 960px;
    min-height: 540px;
    overflow: hidden;
    background: #071016;
    color: #f2f7f8;
    font-family: "Montserrat";
    font-size: 28px;
    font-weight: 500;
    line-height: 44px;
}

button {
    font-family: "Montserrat";
    font-size: 28px;
    font-style: normal;
    font-weight: 500;
    line-height: 44px;
    nav: auto;
}

button:focus, .station-card:focus, .filter:focus, .play-button:focus, .icon-button:focus {
    border-color: #ffffff;
}

.app-shell {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #071016;
}

.topbar {
    height: 96px;
    padding: 0 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px #31505d;
    background: #071016;
}

.brand { display: flex; align-items: center; gap: 18px; }
.brand-mark {
    display: block;
    width: 54px;
    height: 54px;
    border: 2px #70e1dc;
    border-radius: 10px;
    color: #70e1dc;
    font-size: 20px;
    line-height: 50px;
    text-align: center;
}
.brand-name { font-size: 32px; line-height: 48px; letter-spacing: 1px; }

.icon-button {
    position: relative;
    display: block;
    width: 62px;
    height: 62px;
    padding: 0;
    border: 2px #31505d;
    border-radius: 0;
    background: #0d1b24;
    color: #f2f7f8;
}
.search-icon { position: absolute; left: 16px; top: 14px; display: block; width: 30px; height: 30px; }
.search-ring {
    position: absolute;
    left: 1px;
    top: 1px;
    display: block;
    width: 18px;
    height: 18px;
    border: 3px #70e1dc;
    border-radius: 9px;
}
.search-step {
    position: absolute;
    display: block;
    width: 4px;
    height: 4px;
    background: #70e1dc;
}
.search-step-a { left: 18px; top: 18px; }
.search-step-b { left: 21px; top: 21px; }
.search-step-c { left: 24px; top: 24px; }

.main { position: relative; flex: 1; min-height: 0; }
.state-panel {
    position: absolute;
    inset: 0;
    display: none;
    padding: 38px 64px 96px;
    overflow: hidden;
}
.state-panel.is-active { display: block; }

h1, h2, p { margin-top: 0; }
h1 { margin-bottom: 0; font-size: 48px; line-height: 68px; }
h2 { margin-bottom: 4px; font-size: 36px; line-height: 52px; }
.brand-name, h1, h2, .station-name, .station-art, .player-art,
.selection-label, .filter.active, .play-button { font-weight: 500; }
.muted { color: #b7c7cb; }

.screen-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 30px;
}
.filter-row { display: flex; gap: 12px; }
.filter {
    min-height: 62px;
    padding: 6px 24px;
    border: 2px transparent;
    border-radius: 0;
    background: transparent;
    color: #b7c7cb;
}
.filter.active { border-color: #70e1dc; background: #1c3b48; color: #f2f7f8; }

.content-layout { display: flex; align-items: flex-start; gap: 30px; }
.station-area { flex: 1; min-width: 0; }
.station-grid { display: flex; flex-wrap: wrap; gap: 18px; }
.station-card {
    position: relative;
    display: flex;
    flex: 1 1 45%;
    align-items: center;
    gap: 22px;
    min-width: 360px;
    min-height: 184px;
    padding: 24px;
    border: 2px #31505d;
    border-radius: 0;
    background: #0d1b24;
    color: #f2f7f8;
    text-align: left;
}
.station-card.selected { border-color: #70e1dc; background: #1c3b48; }

.station-art, .player-art {
    display: block;
    flex: none;
    background: #25617a;
    color: #ffffff;
    text-align: center;
    letter-spacing: 1px;
}
.station-art { width: 94px; height: 94px; font-size: 24px; line-height: 94px; }
.station-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 8px; padding-right: 44px; overflow: visible; }
.station-name, .station-meta { display: block; overflow-x: hidden; overflow-y: visible; text-overflow: ellipsis; white-space: nowrap; }
.station-name { font-size: 32px; line-height: 48px; }
.station-meta { color: #b7c7cb; font-size: 28px; line-height: 44px; }
.favorite {
    position: absolute;
    top: 18px;
    right: 20px;
    display: block;
    width: 24px;
    height: 24px;
    border: 3px #70e1dc;
}
.favorite.saved { background: #70e1dc; }

.selection-card {
    width: 430px;
    flex: none;
    overflow: hidden;
    padding: 24px;
    border: 2px #70e1dc;
    background: #142934;
}
.selection-label { margin-bottom: 14px; color: #70e1dc; font-size: 24px; line-height: 38px; letter-spacing: 1px; }
.player-art { width: 100%; height: 178px; margin-bottom: 20px; font-size: 48px; line-height: 178px; }
.selection-meta { margin-bottom: 16px; color: #b7c7cb; font-size: 28px; line-height: 44px; }
.ready { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; color: #69d997; font-size: 24px; line-height: 40px; }
.status-dot { display: inline-block; width: 11px; height: 11px; background: #69d997; }
.play-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    min-height: 72px;
    padding: 8px 22px;
    border: 2px #70e1dc;
    border-radius: 0;
    background: #70e1dc;
    color: #061016;
}
.play-symbol {
    display: block;
    width: 0;
    height: 0;
    border-top: 11px transparent;
    border-bottom: 11px transparent;
    border-left: 17px #061016;
}

.bottom-bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 28px;
    height: 76px;
    padding: 0 64px;
    border-top: 2px #31505d;
    background: #071016;
    color: #b7c7cb;
    font-size: 24px;
    line-height: 38px;
}
.controller-hint { display: flex; align-items: center; gap: 10px; overflow: visible; }
.controller-icon { display: block; flex: none; width: 36px; height: 36px; }
.connection-status { display: flex; align-items: center; gap: 10px; margin-left: auto; color: #69d997; }

.state-panel[data-state="boot"], .state-panel[data-state="empty"], .state-panel[data-state="error"] {
    align-items: center;
    justify-content: center;
    text-align: center;
}
.state-panel[data-state="boot"].is-active, .state-panel[data-state="empty"].is-active, .state-panel[data-state="error"].is-active { display: flex; }
.boot-mark { margin-bottom: 20px; color: #70e1dc; font-size: 48px; line-height: 76px; }
.message-card { width: 720px; padding: 56px; border: 2px #31505d; background: #0d1b24; }
.error-card { border-color: #ff7c7c; }
.action-button { min-height: 68px; margin-top: 18px; padding: 8px 24px; border: 2px #70e1dc; background: #1e8f94; color: #f2f7f8; }

.art-orange { background: #a45335; }
.art-green { background: #36735e; }
.art-purple { background: #684b8d; }
