<rml>
    <head>
        <title>Radio Browser</title>
        <link type="text/rcss" href="styles/app.rcss" />
    </head>
    <body>
        <div class="app-shell">
            <header class="topbar">
                <div class="brand">
                    <div class="brand-mark" aria-hidden="true">ON</div>
                    <div class="brand-name">RADIO BROWSER</div>
                </div>
                <button class="icon-button" aria-label="Search stations">
                    <span class="search-icon" aria-hidden="true">
                        <span class="search-ring"></span>
                        <span class="search-handle"></span>
                    </span>
                </button>
            </header>

            <main class="main">
                <section id="state-boot" class="state-panel" data-state="boot">
                    <div class="boot-mark" aria-hidden="true">ON AIR</div>
                    <h1>Radio Browser</h1>
                    <p class="muted">Loading stations...</p>
                </section>

                <section id="state-browse" class="state-panel is-active" data-state="browse">
                    <div class="screen-header">
                        <h1>Popular stations</h1>
                        <nav class="filter-row" aria-label="Station filters">
                            <button class="filter active">Popular</button>
                            <button class="filter">Favorites</button>
                            <button class="filter">Genres</button>
                        </nav>
                    </div>

                    <div class="content-layout">
                        <div class="station-area">
                            <div class="station-grid">
                                <button class="station-card selected">
                                    <span class="station-art art-blue">FM</span>
                                    <span class="station-copy">
                                        <span class="station-name">KEXP 90.3 FM</span>
                                        <span class="station-meta">Seattle  -  Alternative</span>
                                    </span>
                                    <span class="favorite saved" aria-label="Saved"></span>
                                </button>
                                <button class="station-card">
                                    <span class="station-art art-orange">JAZZ</span>
                                    <span class="station-copy">
                                        <span class="station-name">Jazz24</span>
                                        <span class="station-meta">Seattle  -  Jazz</span>
                                    </span>
                                    <span class="favorite" aria-label="Save"></span>
                                </button>
                                <button class="station-card">
                                    <span class="station-art art-green">BBC</span>
                                    <span class="station-copy">
                                        <span class="station-name">BBC Radio 6 Music</span>
                                        <span class="station-meta">United Kingdom  -  Eclectic</span>
                                    </span>
                                    <span class="favorite" aria-label="Save"></span>
                                </button>
                                <button class="station-card">
                                    <span class="station-art art-purple">NTS</span>
                                    <span class="station-copy">
                                        <span class="station-name">NTS Radio</span>
                                        <span class="station-meta">London  -  Electronic</span>
                                    </span>
                                    <span class="favorite" aria-label="Save"></span>
                                </button>
                            </div>
                        </div>

                        <aside class="selection-card" aria-label="Selected station">
                            <p class="selection-label">SELECTED</p>
                            <div class="player-art art-blue">FM</div>
                            <h2>KEXP 90.3 FM</h2>
                            <p class="selection-meta">Seattle  -  Alternative</p>
                            <p class="ready"><span class="status-dot"></span><span>Ready</span></p>
                            <button class="play-button" aria-label="Play selected station">
                                <span class="play-symbol" aria-hidden="true"></span>
                                <span>Play station</span>
                            </button>
                        </aside>
                    </div>
                </section>

                <section id="state-empty" class="state-panel" data-state="empty">
                    <div class="message-card">
                        <h1>No favorites yet</h1>
                        <p class="muted">Save a station to find it here.</p>
                    </div>
                </section>

                <section id="state-error" class="state-panel" data-state="error">
                    <div class="message-card error-card">
                        <h1>Stations unavailable</h1>
                        <p class="muted">Check the network and try again.</p>
                        <button class="action-button">Try again</button>
                    </div>
                </section>
            </main>

            <footer class="bottom-bar">
                <div class="controller-hint">
                    <span class="pad-icon pad-cross" aria-hidden="true">
                        <span class="pad-stroke cross-a"></span>
                        <span class="pad-stroke cross-b"></span>
                    </span>
                    <span>Select</span>
                </div>
                <div class="controller-hint">
                    <span class="pad-icon pad-circle" aria-hidden="true"><span class="pad-ring"></span></span>
                    <span>Back</span>
                </div>
                <div class="controller-hint">
                    <span class="pad-icon pad-square" aria-hidden="true"><span class="pad-box"></span></span>
                    <span>Save</span>
                </div>
                <div class="controller-hint">
                    <span class="pad-icon pad-triangle" aria-hidden="true">
                        <span class="pad-stroke triangle-left"></span>
                        <span class="pad-stroke triangle-right"></span>
                        <span class="pad-stroke triangle-bottom"></span>
                    </span>
                    <span>Details</span>
                </div>
                <div class="controller-hint">
                    <span class="pad-icon pad-options" aria-hidden="true">
                        <span class="option-line option-a"></span>
                        <span class="option-line option-b"></span>
                        <span class="option-line option-c"></span>
                    </span>
                    <span>Menu</span>
                </div>
                <div class="connection-status"><span class="status-dot"></span><span>Connected</span></div>
            </footer>
        </div>
    </body>
</rml>
