* {
    box-sizing: border-box;
}

body, div, header, main, section, aside, footer, span, button, img {
    display: block;
}

body {
    width: 1920px;
    height: 1080px;
    margin: 0;
    overflow: hidden;
    background-color: #071218;
    color: #f1f5f7;
    font-family: "Montserrat";
    font-size: 24px;
    font-style: normal;
    font-weight: 500;
    line-height: 38px;
}

button {
    margin: 0;
    padding: 0;
    border: 1px #345866;
    border-radius: 0px;
    background-color: #10252e;
    color: #f1f5f7;
    font-family: "Montserrat";
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 32px;
    text-align: left;
    nav: auto;
}

#app-shell {
    position: relative;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    background-color: #071218;
}

#header {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1920px;
    height: 96px;
    border-bottom: 2px #345866;
    background-color: #071218;
}

#brand-mark {
    position: absolute;
    left: 64px;
    top: 16px;
    width: 64px;
    height: 64px;
}

.brand-name {
    position: absolute;
    left: 144px;
    top: 23px;
    width: 300px;
    height: 50px;
    overflow: visible;
    color: #f1f5f7;
    font-size: 32px;
    line-height: 50px;
}

#brand-version {
    position: absolute;
    left: 286px;
    top: 30px;
    width: 100px;
    height: 36px;
    overflow: visible;
    color: #6cdbd9;
    font-size: 20px;
    line-height: 32px;
}

.browse-l1, .browse-r1 {
    position: absolute;
    top: 30px;
    height: 36px;
    overflow: visible;
    color: #6cdbd9;
    font-size: 20px;
    line-height: 32px;
}

.browse-l1 {
    left: 1638px;
    width: 32px;
}

.browse-label {
    position: absolute;
    left: 1678px;
    top: 30px;
    width: 84px;
    height: 36px;
    overflow: visible;
    color: #b8c8cf;
    font-size: 20px;
    line-height: 32px;
}

.browse-r1 {
    left: 1770px;
    width: 32px;
}

#catalog-screen {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1920px;
    height: 1004px;
    overflow: hidden;
}

#heading {
    position: absolute;
    left: 64px;
    top: 106px;
    width: 610px;
    height: 62px;
    overflow: visible;
    color: #f1f5f7;
    font-size: 40px;
    line-height: 62px;
}

