    text-align: center;
}

.focused, button:focus {
    border-color: #6cdbd9;
}

#play-button.focused, #credit-button.focused, #credits-close.focused {
    border: 4px #f1f5f7;
}

#credit-button.focused {
    background-color: #1b414c;
    color: #f1f5f7;
}

#search-query.focused, #filter-0.focused, #filter-1.focused,
#filter-2.focused, #filter-3.focused, #search-reset.focused {
    border: 4px #6cdbd9;
    background-color: #1b414c;
}

#search-apply.focused {
    border: 4px #f1f5f7;
    background-color: #64e6e3;
}

.selected {
    border-color: #6cdbd9;
}

.active {
    color: #f1f5f7;
}

.warning {
    color: #f0bd61;
}

.error {
    color: #f16f72;
}

.playing {
    color: #64e6a6;
}

#connection-dot.warning, #detail-status-dot.warning, .warning .status-dot {
    background-color: #f0bd61;
}

#connection-dot.error, #detail-status-dot.error, .error .status-dot {
    background-color: #f16f72;
}

.station-card.playing {
    border-color: #64e6a6;
}

.station-card.playing .live-mark {
    display: block;
}

#now-panel.playing .eq-bar, #now-art.playing .eq-bar, .eq-bar.playing {
    background-color: #6cdbd9;
}

#play-button.playing {
    border-color: #64e6a6;
    background-color: #64e6a6;
}

.hidden {
    display: none;
}
